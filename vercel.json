{
  "headers": [
    {
      "source": "/pdfs/Joshua_Seideman_Resume_08092026.pdf",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/ai-chat.js": {
      "includeFiles": "server/knowledge/**"
    }
  },
  "rewrites": [
    {
      "source": "/resume",
      "destination": "/resume/index.html"
    },
    {
      "source": "/projects",
      "destination": "/projects/index.html"
    },
    {
      "source": "/ai-chat",
      "destination": "/ai-chat/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
